# Email service (Resend) — required for the contact form
# 1. Sign up at https://resend.com (free tier: 100 emails/day, 3,000/month)
# 2. Create an API key at https://resend.com/api-keys
# 3. Copy this file to `.env.local` and fill in the values:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where notifications are delivered (your Gmail inbox)
CONTACT_TO_EMAIL=aruns261123@gmail.com

# Who the email appears to come from.
# Initial testing: Resend provides `onboarding@resend.dev`, which sends strictly
# to the email address registered with your Resend account (aruns261123@gmail.com).
# Production: Add and verify your custom domain in Resend (SPF, DKIM, DMARC)
# and update this to:
#   RESEND_FROM_EMAIL="Arun Saini Portfolio <contact@yourdomain.com>"
RESEND_FROM_EMAIL="Arun Saini Portfolio <onboarding@resend.dev>"
